---
/**
 * /terms — manifest route: src/pages/TermsOfService.tsx → url_path "/terms"
 * Canonical: https://ladestack.in/terms (no page-level JSON-LD in manifest)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Service - Lade Stack"
  description="Read our Terms of Service to understand the rules and regulations for using Lade Stack's services."
  canonical="https://ladestack.in/terms"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Terms of Service - Lade Stack',
    description:
      "Read our Terms of Service to understand the rules and regulations for using Lade Stack's services.",
    url: 'https://ladestack.in/terms',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Terms of Service - Lade Stack',
    description:
      "Read our Terms of Service to understand the rules and regulations for using Lade Stack's services.",
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={[]}
>
  <h1>Terms of Service</h1>
  <p>
    The rules and regulations for using Lade Stack&apos;s services. See also our{' '}
    <a href="/privacy">Privacy Policy</a>.
  </p>
  <p>
    Questions? <a href="/contact">Contact us</a>.
  </p>
</BaseLayout>
