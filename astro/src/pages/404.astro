---
/**
 * 404 — manifest route: src/pages/NotFound.tsx → url_path "/*"
 * NON-INDEXABLE: robots index:false, follow:false. Astro serves this file as
 * the 404 page; it is excluded from the sitemap via astro.config.mjs filter.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 - Page Not Found - Lade Stack"
  description={null}
  canonical="https://ladestack.in/404"
  robots={{ index: false, follow: false, custom: null }}
  openGraph={{
    title: '404 - Page Not Found - Lade Stack',
    description: null,
    url: 'https://ladestack.in/404',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: '404 - Page Not Found - Lade Stack',
    description: null,
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={[]}
>
  <h1>404 — Page not found</h1>
  <p>The page you&apos;re looking for doesn&apos;t exist.</p>
  <p><a href="/">Return to Home</a></p>
</BaseLayout>
