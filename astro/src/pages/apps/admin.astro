---
/**
 * /apps/admin — manifest route: src/pages/AppsAdmin.tsx → url_path "/apps/admin"
 * NON-INDEXABLE: robots index:false, follow:false (matches manifest + source
 * robots.txt `Disallow: /apps/admin`). Excluded from sitemap via the
 * @astrojs/sitemap `filter` in astro.config.mjs. Add auth gating before launch.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Apps Admin Dashboard - Lade Stack"
  description={null}
  canonical="https://ladestack.in/apps/admin"
  robots={{ index: false, follow: false, custom: null }}
  openGraph={{
    title: 'Apps Admin Dashboard - Lade Stack',
    description: null,
    url: 'https://ladestack.in/apps/admin',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Apps Admin Dashboard - Lade Stack',
    description: null,
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={[]}
>
  <h1>Apps Admin Dashboard</h1>
  <p>Restricted area. <a href="/apps">Back to Apps</a> · <a href="/">Home</a></p>
</BaseLayout>
